# AuroraShop — variables para el entorno LOCAL (docker compose).
# Copia este archivo a .env (el .gitignore lo excluye) y cambia las contrasenas.
# Generar una contrasena aleatoria:  openssl rand -base64 24
# Nunca uses aqui credenciales reales ni las de GCP.

MYSQL_ROOT_PASSWORD=cambia-esto-root
DB_NAME=aurorashop
DB_USER=aurora_app
DB_PASSWORD=cambia-esto-app
WP_TABLE_PREFIX=aur_

# Claves y salts de WordPress: opcionales en local (si faltan se generan al arrancar).
# En GKE vienen de Secret Manager (auth-keys, salts).
